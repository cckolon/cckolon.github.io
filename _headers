/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.css
  ! Cache-Control
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/*.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

